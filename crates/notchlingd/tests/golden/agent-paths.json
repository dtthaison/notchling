  "exitCodes": [
    {"code":0,"meaning":"Done: applied, answered, allowed and applied, or read.","name":"ok"},
    {"code":1,"meaning":"Notchling tried and it didn't work, or the request was withdrawn.","name":"failed"},
    {"code":2,"meaning":"The command line or a value is wrong; nothing changed.","name":"bad_request"},
    {"code":3,"meaning":"No daemon, no answer, a socket Notchling doesn't trust, or a daemon older than this command.","name":"not_running"},
    {"code":4,"meaning":"Not allowed: a switch is off, user-only, another session's, another organization's.","name":"refused"},
    {"code":5,"meaning":"The person said no, dismissed or cancelled.","name":"denied"},
    {"code":6,"meaning":"The request is saved and still waits; its id is in the output.","name":"pending"},
    {"code":7,"meaning":"A limit was reached.","name":"busy"},
    {"code":124,"meaning":"No answer in time; the request is closed.","name":"expired"},
    {"code":125,"meaning":"secret only: Notchling stopped before running the command.","name":"stopped"}
  ],
