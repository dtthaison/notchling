{
  "_comment": "The auto-merge zone from the design's 'The line'. Everything else waits for the maintainer. Later entries win; '!' takes a path back out. The five '!**/' lines close each list: AGENTS.md, CLAUDE.md, .claude/, .gitattributes and CODEOWNERS are protected wherever they sit, new or not. Changing this file is a protected change.",
  "auto": [
    "docs/**",
    "!docs/goals.md",
    "!docs/rules.md",
    "!docs/decisions/**",
    "!docs/policies/**",
    "!docs/dev-profile.md",
    "!docs/feature-map.md",
    "!docs/architecture.md",
    "!docs/superpowers/**",
    "!docs/agents/**",
    "!docs/notes/**",
    "apps/flutter/lib/features/**",
    "!apps/flutter/lib/features/pairing/**",
    "apps/flutter/lib/l10n/**",
    "crates/app/**",
    "crates/kit/**",
    "crates/engine/src/transcript/**",
    "crates/engine/src/search/**",
    "locales/**",
    "!locales/languages.json",
    "!locales/*/consent.ftl",
    "crates/locale/src/generated.rs",
    "!crates/**/Cargo.toml",
    "!crates/**/build.rs",
    "!**/AGENTS.md",
    "!**/CLAUDE.md",
    "!**/.claude/**",
    "!**/.gitattributes",
    "!**/CODEOWNERS"
  ],
  "new_files_only": [
    "apps/flutter/test/**",
    "!apps/flutter/**/flutter_test_config.dart",
    "!apps/flutter/**/dart_test.yaml",
    "!**/AGENTS.md",
    "!**/CLAUDE.md",
    "!**/.claude/**",
    "!**/.gitattributes",
    "!**/CODEOWNERS"
  ]
}
