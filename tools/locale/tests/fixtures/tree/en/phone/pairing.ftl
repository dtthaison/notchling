## Pairing

# Title of the pairing screen.
pairing-title = Pair with your Mac

# Shown when no Mac answers.
pairing-cant-find = Can't find your Mac

# Step counter. $total is the number of steps.
pairing-step = Step # of { $total }

# Files a device shared. $count is how many, $name the device.
pairing-files = { $count ->
    [one] { $name } shared { $count } file, 100% done
   *[other] { $name } shared { $count } files, 100% done
}
