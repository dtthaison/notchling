{
  "_comment": "The auto-merge zone from the design's 'The line'. Everything else waits for the maintainer. Later entries win; '!' takes a path back out. The five '!**/' lines close each list: AGENTS.md, CLAUDE.md, .claude/, .gitattributes and CODEOWNERS are protected wherever they sit, new or not. Changing this file is a protected change.",
  "auto": [
    "Sources/Notchling/Chat/Views/**",
    "Sources/Notchling/Notch/NotchView.swift",
    "Sources/Notchling/Notch/NotchRows.swift",
    "Sources/Notchling/Notch/NotchPeek.swift",
    "Sources/Notchling/Notch/NotchDetail.swift",
    "Sources/Notchling/Notch/NotchCardParts.swift",
    "Sources/Notchling/Notch/TabPerch.swift",
    "Sources/Notchling/Notch/Pet/**",
    "Sources/Notchling/Search/**",
    "Sources/Notchling/DesignKit/**",
    "Sources/Notchling/Pages/PagesWindow.swift",
    "Sources/Notchling/Chat/ConversationReader.swift",
    "Sources/Notchling/Agents/TranscriptReader.swift",
    "Sources/Notchling/Agents/CodexSessions.swift",
    "Sources/Notchling/Agents/ACPTranscript.swift",
    "Sources/ConsoleCore/ChatTranscript.swift",
    "Sources/ConsoleCore/SubagentReader.swift",
    "Sources/ConsoleCore/TranscriptFacts.swift",
    "docs/**",
    "!docs/goals.md",
    "!docs/rules.md",
    "!docs/decisions/**",
    "!docs/policies/**",
    "!docs/dev-profile.md",
    "!docs/feature-map.md",
    "!docs/architecture.md",
    "!docs/superpowers/**",
    "mobile/lib/features/**",
    "!mobile/lib/features/pairing/**",
    "crates/app/**",
    "crates/kit/**",
    "crates/engine/src/transcript/**",
    "crates/engine/src/search/**",
    "!**/AGENTS.md",
    "!**/CLAUDE.md",
    "!**/.claude/**",
    "!**/.gitattributes",
    "!**/CODEOWNERS"
  ],
  "new_files_only": [
    "Tests/**",
    "Fixtures/**",
    "mobile/test/**",
    "!mobile/**/flutter_test_config.dart",
    "!mobile/**/dart_test.yaml",
    "!**/AGENTS.md",
    "!**/CLAUDE.md",
    "!**/.claude/**",
    "!**/.gitattributes",
    "!**/CODEOWNERS"
  ]
}
